{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/install.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/download",
      "destination": "/downloads/FaceIDMac.zip"
    },
    {
      "source": "/dmg",
      "destination": "/downloads/Face ID for Mac.dmg"
    }
  ]
}
